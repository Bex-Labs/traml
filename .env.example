# Copy this file to .env and fill in the values.
# Contact the team lead for the current credentials.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-secret-key>

# Optional — required for R-007 OpenSanctions PEP/sanctions screening.
# Free for non-commercial use. Sign up at https://www.opensanctions.org/account/
# If not set, R-007 is skipped gracefully and all other rules still run.
OPENSANCTIONS_API_KEY=
